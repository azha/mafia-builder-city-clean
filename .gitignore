# ---- Unity generated (never commit) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ---- IDE / solution (regenerated by Unity) ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Unity crash / build artifacts ----
sysinfo.txt
*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Aa]ssetStoreTools*

# ---- packaged builds ----
*.apk
*.aab
*.unitypackage
*.app

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- node (Tools/) ----
node_modules/

# ---- scratch du test runner Unity ----
# Le Test Framework crée une scène jetable par run PlayMode et la supprime normalement en sortant ;
# un run batchmode qui se termine par EditorApplication.Exit() (notre juge) ne la supprime PAS.
# Mesuré le 2026-08-25 : 10 sur le disque après une journée de runs. Ce sont des artefacts, pas des
# sources — mais 2 ont fini TRACKÉS par le passé, et ceux-là restent suivis (git ignore ce qui n'est
# pas déjà suivi) : ils sont signalés, pas supprimés d'autorité.
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta

# ⛔ La règle [Bb]uild/ ci-dessus (sorties de build Unity) avalait AUSSI un dossier de CODE
# SOURCE du paquet MCP embarqué — Editor/Tools/Build/ : 4 fichiers .cs jamais commitables,
# tout checkout frais (clone, worktree) ouvrait en Safe Mode avec CS0234. Mesuré le 2026-08-30
# sur le worktree pilote-B. Exception :
!Packages/com.coplaydev.unity-mcp/**/[Bb]uild/
