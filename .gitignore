*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Aa]ssetStoreTools*

# ---- packaged builds ----
*.apk
*.aab
*.unitypackage
*.app

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- node (Tools/) ----
node_modules/
